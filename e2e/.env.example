# E2E environment — copy to .env and fill in values
# .env is gitignored and never committed.

# ── Target URL ───────────────────────────────────────────────────────────────
BASE_URL=https://www.episode.watch
FALLBACK_URL=https://last-episode.vercel.app

# ── Test user ─────────────────────────────────────────────────────────────────
# Must be a real account in Supabase (create once, never delete)
TEST_USER_EMAIL=your@email.com
TEST_USER_PASSWORD=yourpassword

# ── Vercel bypass (optional, for CI) ─────────────────────────────────────────
# Get from Vercel → Project → Settings → Deployment Protection → Automation Bypass
# VERCEL_BYPASS_SECRET=

# ── Browser ───────────────────────────────────────────────────────────────────
HEADLESS=true
